<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Crystal.DNAS1Server</RootNamespace>
    <OutputPath>$(SolutionDir)\Build\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- dotnet publish produces one self-contained Linux executable; build/run/VS on Windows are unaffected. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Deploy\**" />
    <Compile Remove="Keys\**" />
    <EmbeddedResource Remove="Deploy\**" />
    <EmbeddedResource Remove="Keys\**" />
    <None Remove="Deploy\**" />
    <None Remove="Keys\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
